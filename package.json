{
  "name": "sora-ui",
  "version": "1.0.27",
  "homepage": "https://ui.soralabs.studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoraLabsOSS/ui.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@workspace/typescript-config": "workspace:*",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.10.7",
    "typescript": "^6.0.0",
    "ultracite": "7.8.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:verify": "turbo build --cache=local:r,remote:r",
    "dev": "turbo dev",
    "dev:www": "turbo dev --filter=www",
    "dev:mcp": "turbo dev --filter=mcp",
    "dev:xmcp": "turbo dev --filter=xmcp",
    "build:mcp": "turbo build --filter=mcp",
    "build:xmcp": "turbo build --filter=xmcp",
    "lint": "turbo lint",
    "lint:links": "bun run --cwd apps/www lint:links",
    "format": "ultracite fix",
    "format:write": "ultracite fix",
    "format:check": "ultracite check",
    "registry:build": "bun run --cwd apps/www registry:build",
    "prepare": "lefthook install",
    "check": "ultracite check",
    "check-types": "turbo check-types",
    "fix": "ultracite fix"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
