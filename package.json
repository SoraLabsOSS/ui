{
  "name": "sora-ui",
  "version": "1.0.27",
  "private": true,
  "homepage": "https://ui.soralabs.studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoraLabsOSS/ui.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:verify": "turbo build --cache=local:r,remote:r",
    "dev": "turbo dev",
    "dev:www": "turbo dev --filter=www",
    "dev:mcp": "turbo dev --filter=mcp",
    "dev:xmcp": "turbo dev --filter=xmcp",
    "build:mcp": "turbo build --filter=mcp",
    "build:xmcp": "turbo build --filter=xmcp",
    "lint": "turbo lint",
    "lint:links": "bun run --cwd apps/www lint:links",
    "format": "ultracite fix",
    "format:write": "ultracite fix",
    "format:check": "ultracite check",
    "registry:build": "bun run --cwd apps/www registry:build",
    "create:primitive": "bun packages/www-cli/src/index.ts create primitive",
    "create:ui": "bun packages/www-cli/src/index.ts create ui",
    "create:catalog": "bun packages/www-cli/src/index.ts create catalog",
    "create:icon": "bun packages/www-cli/src/index.ts create icon",
    "create": "bun packages/www-cli/src/index.ts create",
    "doctor": "bun packages/www-cli/src/index.ts doctor",
    "test:www-cli": "bun run --cwd packages/www-cli test",
    "test:www-cli:slow": "WWW_CLI_RUN_REGISTRY_BUILD=1 bun run --cwd packages/www-cli test:slow",
    "prepare": "lefthook install",
    "check": "ultracite check",
    "check-types": "turbo check-types",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-sonarjs": "^4.2.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.4",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "ultracite": "8.2.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.3.5"
}
