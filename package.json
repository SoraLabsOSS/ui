{
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@workspace/typescript-config": "workspace:*",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2",
    "ultracite": "7.8.1"
  },
  "name": "animate-ui",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
