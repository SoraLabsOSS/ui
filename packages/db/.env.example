# =============================================================================
# DATABASE (Neon)
# Get these from: Neon Console → Connect (choose a branch, user, and database)
# =============================================================================

# Pooled connection URL — used at RUNTIME by the app
# Hostname contains "-pooler" (PgBouncer): postgresql://USER:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Direct Connection URL — used for MIGRATIONS only (drizzle-kit)
# Hostname has NO "-pooler" suffix: postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=""
