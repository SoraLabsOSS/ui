              "min": 0.01,
              "max": 0.5,
              "step": 0.01
            },
            "delay": {
              "value": 0.5,
              "min": 0,
              "max": 2,
              "step": 0.1
            },
            "duration": {
              "value": 0.5,
              "min": 0.1,
              "max": 2,
              "step": 0.1
            },
            "blur": {
              "value": 4,
              "min": 0,
              "max": 20,
              "step": 1
            },
            "yOffset": {
              "value": 0,
              "min": -50,
              "max": 50,
              "step": 1
            },
            "viewportMargin": {
              "value": "0px 0px -10% 0px"
            }
          }
        }
      }
    }
