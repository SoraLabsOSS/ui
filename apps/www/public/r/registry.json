{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "Sora",
  "homepage": "https://ui.soralabs.io.vn",
  "items": [
    {
      "name": "index",
      "type": "registry:style",
      "dependencies": [
        "tw-animate-css",
        "class-variance-authority",
        "lucide-react"
      ],
      "registryDependencies": ["utils"],
      "cssVars": {},
      "files": []
    },
    {
      "name": "demo-text-reveal",
      "type": "registry:ui",
      "title": "Text Reveal Demo",
      "description": "Demo for the Text Reveal animation component.",
      "registryDependencies": ["text-reveal"],
      "files": [
        {
          "path": "registry/demo/primitives/texts/text-reveal/index.tsx",
          "type": "registry:ui",
          "target": "components/sora-ui/demo/texts/text-reveal.tsx"
        }
      ]
    },
    {
      "name": "text-reveal",
      "type": "registry:ui",
      "title": "Text Reveal",
      "description": "A text reveal animation.",
      "dependencies": ["motion"],
      "files": [
        {
          "path": "registry/primitives/texts/text-reveal/index.tsx",
          "type": "registry:ui",
          "target": "components/sora-ui/texts/text-reveal.tsx"
        }
      ],
      "meta": {
        "demoProps": {
          "TextReveal": {
            "as": {
              "value": "h2",
              "options": {
                "h2": "h2",
                "p": "p",
                "span": "span"
              }
            },
            "className": {
              "value": "text-center font-bold text-3xl"
            },
            "text": {
              "value": "Blur Text Animation"
            },
            "splitBy": {
              "value": "words",
              "options": {
                "Words": "words",
                "Characters": "characters"
              }
            },
            "staggerDelay": {
              "value": 0.05,
              "min": 0.01,
              "max": 0.5,
              "step": 0.01
            },
            "delay": {
              "value": 0.5,
              "min": 0,
              "max": 2,
              "step": 0.1
            },
            "duration": {
              "value": 0.5,
              "min": 0.1,
              "max": 2,
              "step": 0.1
            },
            "blur": {
              "value": 4,
              "min": 0,
              "max": 20,
              "step": 1
            },
            "yOffset": {
              "value": 0,
              "min": -50,
              "max": 50,
              "step": 1
            },
            "viewportMargin": {
              "value": "0px 0px -10% 0px"
            }
          }
        }
      }
    }
  ]
}
