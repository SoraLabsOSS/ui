{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "Sora",
  "homepage": "https://animate-ui.com",
  "items": [
    {
      "name": "index",
      "type": "registry:style",
      "dependencies": [
        "tw-animate-css",
        "class-variance-authority",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils"
      ],
      "cssVars": {},
      "files": []
    },
    {
      "name": "hello-world",
      "type": "registry:ui",
      "title": "Hello World",
      "description": "Minimal test block that renders shadcn Button with “Hello World”.",
      "files": [
        {
          "path": "registry/components/hello-world/index.tsx",
          "type": "registry:ui",
          "target": "components/sora/hello-world.tsx"
        }
      ]
    },
    {
      "name": "demo-hello-world",
      "type": "registry:ui",
      "title": "Hello World Demo",
      "description": "Demo for the Hello World test block.",
      "registryDependencies": [
        "@sora/hello-world"
      ],
      "files": [
        {
          "path": "registry/demo/components/hello-world/index.tsx",
          "type": "registry:ui",
          "target": "components/sora/demo/hello-world.tsx"
        }
      ]
    }
  ]
}