# Better Auth (apps/www)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# App URL — defaults to http://localhost:3000 in dev if unset
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Database (also used by @workspace/db)
# Transaction pooler (port 6543) for runtime
DATABASE_URL=""

# Direct connection (port 5432) for drizzle-kit migrate only
DATABASE_URL_DIRECT=""

NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upstash Redis (rate limiting / caching)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
BETTER_AUTH_API_KEY=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=""

# Vercel AI Gateway — docs AI chat (/api/chat)
# Create a key: https://vercel.com/account/ai  (AI Gateway → API Keys)
# Local: required. Vercel production can use OIDC instead.
AI_GATEWAY_API_KEY=""

# Cloudflare AI Search public chat completions URL
AI_SEARCH_CHAT_URL="https://search.axyl.io.vn/chat/completions"