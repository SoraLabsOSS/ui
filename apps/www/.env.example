# All variables are optional for local docs/UI development (`bun run dev:www`).
# Copy to `.env` only when you need auth, bookmarks, or a custom Ask AI endpoint.

# Feature Flags
# NEXT_PUBLIC_ENABLE_AUTH="false" # set to "true" to enable Auth & Bookmarks features

# Better Auth — generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=""

# App URL — defaults to http://localhost:3000
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Database (@workspace/db) — required for sign-in and bookmarks
# DATABASE_URL=""
# DATABASE_URL_DIRECT=""  # drizzle-kit migrate only (port 5432)

# Google OAuth — optional; omit to hide One Tap / Google sign-in
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — optional
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Upstash Redis — optional; auth falls back to in-memory rate limits
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Better Auth Cloud Sentinel — optional
# BETTER_AUTH_API_KEY=""
# NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=""

# Sentry — optional
# SENTRY_AUTH_TOKEN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Ask AI — defaults to the public Cloudflare AI Search instance when unset
# AI_SEARCH_CHAT_URL="https://search.axyl.io.vn/chat/completions"

# Support / Contact email
# NEXT_PUBLIC_SUPPORT_EMAIL="hello@soralabs.studio"
