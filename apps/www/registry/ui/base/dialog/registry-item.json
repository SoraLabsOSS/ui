      "target": "components/sora-ui/base/dialog.tsx"
    }
  ],
  "meta": {
    "inspiration": {
      "type": "reimplemented",
      "label": "Base UI: Dialog (Motion Examples)",
      "url": "https://examples.motion.dev/react/base-dialog",
      "stack": "Base UI and Motion"
    }
  }
}
