  "meta": {
    "demoProps": {
      "TiltCardDemo": {
        "rotationFactor": {
          "value": 8,
          "min": 0,
          "max": 45,
          "step": 1
        },
        "perspective": {
          "value": 1000,
          "min": 400,
          "max": 2000,
          "step": 50
        },
        "scaleOnHover": {
          "value": 1,
          "min": 1,
          "max": 1.15,
          "step": 0.01
        },
        "isReverse": {
          "value": false
        }
      }
    }
