{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-text-roll",
  "type": "registry:ui",
  "title": "Text Roll Demo",
  "description": "Interactive copy button with chromatic text roll feedback.",
  "registryDependencies": ["text-roll"],
  "files": [
    {
      "path": "registry/demo/primitives/texts/text-roll/index.tsx",
      "type": "registry:ui",
      "target": "components/sora-ui/demo/texts/text-roll.tsx"
    }
  ],
  "meta": {
    "demoProps": {
      "TextRollPlayground": {
        "className": {
          "value": "font-medium text-lg tabular-nums"
        },
        "stagger": {
          "value": 45,
          "min": 0,
          "max": 120,
          "step": 5
        },
        "duration": {
          "value": 300,
          "min": 100,
          "max": 600,
          "step": 25
        },
        "bounce": {
          "value": 0.6,
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        "chromatic": {
          "value": true
        }
      }
    }
  }
}
