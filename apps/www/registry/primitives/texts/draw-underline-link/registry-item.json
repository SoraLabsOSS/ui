{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "draw-underline-link",
  "type": "registry:ui",
  "title": "Draw Underline Link",
  "description": "A link with a hand-drawn SVG underline that animates on hover.",
  "dependencies": ["motion", "class-variance-authority"],
  "registryDependencies": ["utils"],
  "files": [
    {
      "path": "registry/primitives/texts/draw-underline-link/index.tsx",
      "type": "registry:ui",
      "target": "components/sora-ui/texts/draw-underline-link.tsx"
    }
  ],
  "meta": {
    "demoProps": {
      "DrawUnderlineLink": {
        "label": {
          "value": "Hover me"
        },
        "variant": {
          "value": "default",
          "options": {
            "Default": "default",
            "Small": "sm",
            "Large": "lg"
          }
        },
        "duration": {
          "value": 0.5,
          "min": 0.2,
          "max": 2,
          "step": 0.1
        },
        "href": {
          "value": "#"
        },
        "underlineColor": {
          "value": "#ff4c24"
        }
      }
    }
  }
}
