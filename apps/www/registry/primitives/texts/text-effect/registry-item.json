{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "text-effect",
  "type": "registry:ui",
  "title": "Text Effect",
  "description": "Preset-driven staggered text reveals with blur, fade, slide, and scale animations, powered by Motion.",
  "dependencies": ["motion"],
  "registryDependencies": ["utils"],
  "files": [
    {
      "path": "registry/primitives/texts/text-effect/index.tsx",
      "type": "registry:ui",
      "target": "components/sora-ui/texts/text-effect.tsx"
    }
  ],
  "meta": {
    "inspiration": {
      "type": "inspired",
      "label": "motion-primitives",
      "url": "https://motion-primitives.com/docs/text-effect"
    },
    "demoProps": {
      "TextEffect": {
        "as": {
          "value": "h2",
          "options": {
            "h2": "h2",
            "p": "p",
            "span": "span"
          }
        },
        "children": {
          "value": "Motion-first text effects"
        },
        "className": {
          "value": "text-center font-bold text-3xl"
        },
        "preset": {
          "value": "fade-in-blur",
          "options": {
            "Fade in blur": "fade-in-blur",
            "Blur": "blur",
            "Fade": "fade",
            "Slide": "slide",
            "Scale": "scale"
          }
        },
        "per": {
          "value": "word",
          "options": {
            "Word": "word",
            "Char": "char",
            "Line": "line"
          }
        },
        "delay": {
          "value": 0,
          "min": 0,
          "max": 2,
          "step": 0.1
        },
        "speedReveal": {
          "value": 1,
          "min": 0.25,
          "max": 3,
          "step": 0.25
        },
        "speedSegment": {
          "value": 1,
          "min": 0.25,
          "max": 3,
          "step": 0.25
        },
        "scrollTrigger": {
          "value": true
        }
      }
    }
  }
}
