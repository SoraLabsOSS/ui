        "duration": {
          "value": 0.75,
          "min": 0.2,
          "max": 2,
          "step": 0.05
        },
        "delay": {
          "value": 0,
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "direction": {
          "value": "left",
          "options": {
            "left": "left",
            "right": "right",
            "up": "up",
            "down": "down"
          }
        }
      }
    }
  }
}
