{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["node", "bun", "mdx"],
    "paths": {
      "@/.source": ["./.source/server.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/auth-ui/src/better-auth-ui.d.ts"
  ],
  "exclude": ["node_modules", "sandbox"]
}
