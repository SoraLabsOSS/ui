rrent.icon}\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        <div\n          className=\"-mx-8 overflow-hidden px-8\"\n          style={{\n            WebkitMaskImage:\n              \"linear-gradient(to right, transparent, black 2rem, black calc(100% - 2rem), transparent)\",\n            maskImage:\n              \"linear-gradient(to right, transparent, black 2rem, black calc(100% - 2rem), transparent)\",\n          }}\n        >\n          <TextMorph\n            as=\"span\"\n            duration={600}\n            ease=\"cubic-bezier(0.41, 1.03, 0.6, 1.03)\"\n          >\n            {current.label}\n          </TextMorph>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default TextMorphTransaction;"
