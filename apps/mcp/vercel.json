{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health"
    },
    {
      "src": "/",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/mcp"
    },
    {
      "src": "/api/mcp",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/mcp"
    },
    {
      "src": "/(.*)",
      "methods": ["GET", "HEAD", "DELETE"],
      "status": 405,
      "headers": {
        "Content-Type": "application/json",
        "Allow": "POST, OPTIONS",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "body": "{\"error\":\"Method Not Allowed\",\"transport\":\"stateless\",\"message\":\"POST-only MCP. Remote SSE polling is disabled. Use POST for JSON-RPC or run MCP via STDIO locally.\"}"
    }
  ]
}
