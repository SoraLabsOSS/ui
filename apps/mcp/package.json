{
  "name": "mcp",
  "version": "0.0.1",
  "description": "mcp MCP server",
  "type": "module",
  "bin": {
    "mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun x tsc",
    "watch": "bun x tsc --watch",
    "dev": "bun x tsc && node dist/index.js",
    "start": "node dist/index.js",
    "debug": "npx -y mcp-debug",
    "vercel-build": "bun run build"
  },
  "dependencies": {
    "mcp-framework": "^0.2.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
